generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================================================
// ENUMS
// ====================================================

enum RoleName {
  SUPER_ADMIN
  ADMIN
  TENANT
}

enum RoomStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  // SEMI_ANNUAL = 6 bulan
  SEMI_ANNUAL
  ANNUALLY
}

enum ContractStatus {
  ACTIVE
  TERMINATED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  TRANSFER
  CASH
  QRIS
}

enum ExpenseClassification {
  OPERATIONAL
  INVESTMENT
}

enum TransactionCategory {
  RENT
  UTILITIES
  INTERNET
  MAINTENANCE
  SALARY
  OTHER
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  AC
  FURNITURE
  OTHER
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum AnnouncementCategory {
  KERJA_BAKTI
  MAINTENANCE
  ACARA
  UMUM
}

enum NotificationType {
  DUE_DATE_REMINDER
  BIRTHDAY_WISH
  ANNOUNCEMENT
  INVOICE
}

enum NotificationStatus {
  SENT
  FAILED
}

// ====================================================
// RBAC & USER MODELS (Compatible with Better-Auth)
// ====================================================

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  passwordHash        String?
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  assignedPropertyId  String?
  assignedProperty    Property?            @relation("AssignedPropertyUsers", fields: [assignedPropertyId], references: [id], onDelete: SetNull)
  propertyAccesses    UserPropertyAccess[]
  createdTransactions Transaction[]        @relation("UserTransactions")
  sessions            Session[]
  accounts            Account[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ====================================================
// MULTI-PROPERTY & ACCESS CONTROL
// ====================================================

model Property {
  id                    String               @id @default(cuid())
  name                  String
  address               String
  description           String?
  imageUrl              String?              @db.Text
  
  rooms                 Room[]
  cctvDevices           CctvDevice[]
  userAccesses          UserPropertyAccess[]
  assignedUsers         User[]               @relation("AssignedPropertyUsers")
  transactions          Transaction[]
  sharedCostAllocations SharedCostProperty[]
  announcements         Announcement[]
  aiFinancialReports    AiFinancialReport[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("properties")
}

model UserPropertyAccess {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("user_property_accesses")
}

model CctvDevice {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  streamUrl  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cctv_devices")
}

// ====================================================
// ROOM, TENANT & RENTAL CONTRACT MODELS
// ====================================================

model Room {
  id              String           @id @default(cuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber      String
  type            String           @default("Standard")
  price           Decimal          @default(0) @db.Decimal(12, 2)
  facilities      String?
  status          RoomStatus       @default(VACANT)
  rentalContracts RentalContract[]
  complaints      Complaint[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([propertyId, roomNumber])
  @@map("rooms")
}

model Tenant {
  id                 String           @id @default(cuid())
  name               String
  NIK                String           @unique
  phoneNumber        String
  whatsappNumber     String?
  email              String?
  birthDate          DateTime?
  occupation         String?
  institution        String?
  originAddress      String?
  emergencyName      String?
  emergencyRelation  String?
  emergencyPhone     String?
  vehicle            String?
  deposit            Decimal?         @default(0) @db.Decimal(12, 2)
  notes              String?          @db.Text
  ktpUrl             String?          @db.Text
  status             TenantStatus     @default(ACTIVE)
  rentalContracts    RentalContract[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("tenants")
}

model RentalContract {
  id           String         @id @default(cuid())
  roomId       String
  room         Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingCycle BillingCycle   @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  dueDateDay   Int            @default(1)
  status       ContractStatus @default(ACTIVE)
  invoices     Invoice[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("rental_contracts")
}

// ====================================================
// INVOICE & DIGITAL BILLING MODELS
// ====================================================

model Invoice {
  id            String         @id @default(cuid())
  contractId    String
  contract      RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceNumber String         @unique
  periodMonth   Int?
  periodYear    Int?
  amount        Decimal        @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        InvoiceStatus  @default(PENDING)
  pdfUrl        String?
  transactions  Transaction[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("invoices")
}

// ====================================================
// CASHFLOW, EXPENSES & COMPLAINTS
// ====================================================

model Transaction {
  id              String                 @id @default(cuid())
  propertyId      String?
  property        Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy       String
  creator         User                   @relation("UserTransactions", fields: [createdBy], references: [id], onDelete: Restrict)
  invoiceId       String?
  invoice         Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  complaintId     String?
  complaint       Complaint?             @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  type            TransactionType        @default(EXPENSE)
  category        TransactionCategory    @default(OTHER)
  classification  ExpenseClassification? @default(OPERATIONAL)
  paymentMethod   PaymentMethod          @default(TRANSFER)
  amount          Decimal                @db.Decimal(12, 2)
  description     String?
  transactionDate DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("transactions")
}

model SharedCost {
  id          String               @id @default(cuid())
  description String
  amount      Decimal              @db.Decimal(12, 2)
  splitMethod String               @default("Rata per kos")
  allocations SharedCostProperty[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("shared_costs")
}

model SharedCostProperty {
  id              String     @id @default(cuid())
  sharedCostId    String
  sharedCost      SharedCost @relation(fields: [sharedCostId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  allocatedAmount Decimal?   @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())

  @@unique([sharedCostId, propertyId])
  @@map("shared_cost_properties")
}

model Complaint {
  id           String            @id @default(cuid())
  roomId       String
  room         Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category     ComplaintCategory @default(OTHER)
  description  String
  status       ComplaintStatus   @default(PENDING)
  reportedDate DateTime          @default(now())
  resolvedDate DateTime?
  transactions Transaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("complaints")
}

// ====================================================
// ENGAGEMENT, NOTIFICATIONS & AI REPORTING
// ====================================================

model Announcement {
  id          String               @id @default(cuid())
  propertyId  String?
  property    Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title       String
  content     String
  category    AnnouncementCategory @default(UMUM)
  isBroadcast Boolean              @default(false)
  sentAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("announcements")
}

model NotificationLog {
  id              String             @id @default(cuid())
  recipientNumber String
  messageType     NotificationType
  status          NotificationStatus @default(SENT)
  notes           String?
  sentAt          DateTime           @default(now())

  @@map("notification_logs")
}

model AiFinancialReport {
  id                 String    @id @default(cuid())
  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  periodMonth        Int
  periodYear         Int
  totalIncome        Decimal   @db.Decimal(12, 2)
  totalExpense       Decimal   @db.Decimal(12, 2)
  netProfit          Decimal   @db.Decimal(12, 2)
  occupancyRate      Float
  aiNarrativeSummary Json
  pdfFileUrl         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("ai_financial_reports")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
