# ==============================================================================
# HOMEEKOST — ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# Salin file ini menjadi .env lalu isi nilainya sesuai lingkungan Anda.
# ==============================================================================

# ─── 1. SERVER & APPLICATION URL ───
PORT=3000
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="ganti_dengan_random_secret_string_minimal_32_karakter"

# ─── 2. DATABASE POSTGRESQL ───
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeekost?schema=public"

# ─── 3. EMAIL TRANSPORTER (GMAIL SMTP / NODEMAILER) ───
# Gunakan Google App Password 16 karakter (Bukan password akun Gmail biasa)
# Panduan: https://myaccount.google.com/security -> 2-Step Verification -> App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="alamatemailanda@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="HomeeKost Management <alamatemailanda@gmail.com>"

# ─── 4. WHATSAPP GATEWAY (FONNTE API) ───
# Dapatkan token perangkat dari dashboard Fonnte (https://fonnte.com)
FONNTE_API_TOKEN="fonnte_device_token_anda_disini"
FONNTE_API_URL="https://api.fonnte.com/send"

# ─── 5. AI ENGINE (GOOGLE GEMINI / GROQ) ───
# Untuk fitur RAG Ringkasan Eksekutif Finansial & KTP Vision OCR
# Mendukung multiple key (dipisahkan koma) untuk auto-failover/rotasi jika kuota rate limit (429/Resource Exhausted):
GEMINI_API_KEYS="AIzaSy_key1,AIzaSy_key2,AIzaSy_key3"
GEMINI_API_KEY="AIzaSy_gemini_api_key_anda"
GEMINI_MODEL="gemini-3.5-flash"
GROQ_API_KEY="gsk_groq_api_key_anda"
